# ============================================================
# CFTA Monorepo Production Environment Variables
# Copy this file to .env on your production server:
#   cp .env.production.example .env
# ============================================================

# --- Node Environment ---
NODE_ENV=production

# --- Production Cloud Database Connection ---
# Replace with your production database URL (e.g. Neon, Supabase, AWS RDS)
DATABASE_URL=postgresql://prod_user:prod_password@ep-cloud-db.neon.tech/cfta_prod?sslmode=require

# --- CFTA Backend API ---
PORT=4000
TRON_NETWORK_URL=https://api.trongrid.io
TRONGRID_API_KEY=your_production_trongrid_api_key

# --- CFTA Web (Next.js Frontend) ---
WEB_PORT=3000
# Replace with your production public API domain
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
