# ============================================================
# CFTA Monorepo Environment Variables
# Copy this file to .env for local host development:
#   cp .env.example .env
# ============================================================

# --- Node Environment ---
NODE_ENV=development

# --- Local Host Database Connection ---
# Used when running migrations or services directly on your host machine
DATABASE_URL=postgresql://cfta_user:cfta_secure_password@localhost:5432/cfta_db?schema=public

# --- CFTA Backend API ---
PORT=4000
TRON_NETWORK_URL=https://api.trongrid.io
TRONGRID_API_KEY=

# --- CFTA Web (Next.js Frontend) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
